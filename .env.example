# PostgreSQL (docker compose)
POSTGRES_USER=bankuser
POSTGRES_PASSWORD=bankpass
POSTGRES_DB=bankdb
POSTGRES_PORT=5432

# Spring (optional, defaults match above)
DB_HOST=localhost
DB_PORT=5432
DB_USER=bankuser
DB_PASSWORD=bankpass
DB_NAME=bankdb
SERVER_PORT=8080

# JWT (change in production)
JWT_SECRET=your-256-bit-secret-change-in-production-must-be-long-enough
JWT_EXPIRATION_MS=86400000
JWT_TTL_MS=86400000

# Card encryption key (base64, 32 bytes for AES-256)
CARD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
